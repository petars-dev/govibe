# This application's settings. Embedded by main.go, so the binary stays one file, and
# layered over the framework's defaults: add keys here, or override a default by naming
# it. Values are `${ENV:default}` placeholders, resolved from the process environment;
# quote a placeholder to keep its value a string. The framework's own keys (server,
# database, scheduler, dev) are described in "GoVibe: Configuration" under /dev/docs.
#
# The Hello GoVibe demo needs no settings of its own.
[[- if .MariaDB]]

database:
  # The goose dialect of the migrations under storage/migrations/sql.
  type: ${DATABASE_TYPE:mysql}
  mariadb:
    # When set, the app connects on start and applies its embedded migrations. For
    # example: user:pass@tcp(127.0.0.1:3306)/[[.Name]]?parseTime=true&multiStatements=true
    # (parseTime=true is required: goose reads timestamps from its version table).
    dsn: ${MARIADB_DSN:}
[[- else]]
#
# To use a database, set MARIADB_DSN (user:pass@tcp(127.0.0.1:3306)/[[.Name]]?parseTime=true&multiStatements=true):
# the app then connects on start and applies the migrations under storage/migrations/sql.
[[- end]]
#
# Your own settings go under a name of your own and are read through the runtime, as
# rt.Config.Get("[[.Name]].greeting") or rt.Config.Unmarshal("[[.Name]]", &cfg):
#
# [[.Name]]:
#   greeting: ${GREETING:Hello}
