package config

import (
	"testing"
	"testing/fstest"

	govibeconfig "[[.Framework]]/config"
)

func TestLoadReadsTheSection(t *testing.T) {
	env := fstest.MapFS{"env.yml": &fstest.MapFile{Data: []byte([[.SampleYAML]])}}
	cfg, err := govibeconfig.Load(env)
	if err != nil {
		t.Fatal(err)
	}
	got, err := Load(cfg)
	if err != nil {
		t.Fatal(err)
	}
	[[- if .SampleCheck]]
	if [[.SampleCheck]] {
		t.Errorf("Load = %+v", got)
	}
	[[- else]]
	_ = got
	[[- end]]
}
