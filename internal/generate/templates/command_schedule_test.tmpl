package main

import (
	"testing"
	"time"

	"[[.Framework]]/govibetest"
)

// [[.Use]] runs at its due time ([[.Schedule]]): the app is booted the way serve boots
// it, on a fake clock the test moves.
func Test[[.Func]]RunsOnSchedule(t *testing.T) {
	start := time.Date(2026, time.March, 1, 12, 0, 0, 0, time.UTC)
	srv := govibetest.Boot(t, newApp(), govibetest.WithTime(start))
	srv.Clock.AdvanceTo([[.NextExpr]])
	runs := srv.Runs("[[.Use]]")
	if len(runs) != 1 || runs[0].Status != "ok" {
		t.Fatalf("runs = %+v, want one ok run", runs)
	}
}
