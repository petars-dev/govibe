diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/business/services/codegraph/origin.go fw/business/services/codegraph/origin.go
--- base/business/services/codegraph/origin.go	1970-01-01 02:00:00
+++ fw/business/services/codegraph/origin.go	2026-10-11 10:56:54
@@ -0,0 +1,162 @@
+package codegraph
+
+import (
+	"path"
+	"strings"
+
+	"github.com/cayleygraph/quad"
+)
+
+// S2 spike: whose code is a runtime function? The source file decides, never the
+// symbol: Go names an inlined closure after the function it was inlined into, so
+// `example.com/shop/routes.Register.Health.func3` is framework code (web.Health).
+
+const (
+	OriginApp        = "app"
+	OriginFramework  = "framework"
+	OriginDependency = "dependency"
+	OriginStdlib     = "stdlib"
+	OriginUnknown    = "unknown"
+)
+
+const (
+	KindExternal = quad.IRI("kind:external")
+	PredOrigin   = quad.IRI("origin")
+	PredModule   = quad.IRI("module")
+
+	PredHandlerOrigin = quad.IRI("handler_origin")
+)
+
+// BuildModule is one dependency of the running app: its path and version, and for a
+// local `replace` the directory it points at (as compiled).
+type BuildModule struct {
+	Path, Version, ReplaceDir string
+}
+
+// moduleFor finds the module a source file belongs to, from the build's module
+// table: `<mod>@<ver>/` inside the path (module cache, any GOMODCACHE; or the
+// start of the path under -trimpath) or the replace directory. Longest path wins.
+func moduleFor(mods []BuildModule, file string) (BuildModule, string, bool) {
+	best, rel, found := BuildModule{}, "", false
+	for _, m := range mods {
+		var r string
+		switch {
+		case m.ReplaceDir != "" && strings.HasPrefix(file, strings.TrimSuffix(m.ReplaceDir, "/")+"/"):
+			r = strings.TrimPrefix(file, strings.TrimSuffix(m.ReplaceDir, "/")+"/")
+		case m.Version != "" && strings.HasPrefix(file, m.Path+"@"+m.Version+"/"):
+			r = strings.TrimPrefix(file, m.Path+"@"+m.Version+"/")
+		case m.Version != "" && strings.Contains(file, "/"+m.Path+"@"+m.Version+"/"):
+			r = file[strings.Index(file, "/"+m.Path+"@"+m.Version+"/")+len("/"+m.Path+"@"+m.Version+"/"):]
+		default:
+			continue
+		}
+		if !found || len(m.Path) > len(best.Path) {
+			best, rel, found = m, r, true
+		}
+	}
+	return best, rel, found
+}
+
+// resolvedModules makes a local replace directory absolute. The build info records
+// it as written in go.mod (`../fw`, relative to the app module), so it is resolved
+// against the app's compile-time root, which the inspect document's root hint gives.
+func (w *world) resolvedModules(ci *codeIndex) []BuildModule {
+	root := w.buildRoot(ci)
+	out := make([]BuildModule, len(w.x.opts.Modules))
+	for i, m := range w.x.opts.Modules {
+		if m.ReplaceDir != "" && !path.IsAbs(m.ReplaceDir) && root != "" {
+			m.ReplaceDir = path.Join(root, m.ReplaceDir)
+		}
+		out[i] = m
+	}
+	return out
+}
+
+// classify says whose code ref is and, outside the app, which module and package.
+func (w *world) classify(ci *codeIndex, ref handlerRef) (origin, module, pkg string) {
+	fwMod := w.x.opts.FrameworkModule
+	if ref.File == "" || ref.File == "<autogenerated>" {
+		// A method-value wrapper (x.Method-fm) has no source: its symbol is the
+		// declared method, which is not inlined into anything.
+		p := symbolPackage(cleanSymbol(ref.Symbol))
+		switch {
+		case p == "":
+			return OriginUnknown, "", ""
+		case inModule(ci.module, p):
+			return OriginApp, ci.module, p
+		case fwMod != "" && inModule(fwMod, p):
+			return OriginFramework, fwMod, p
+		case !strings.Contains(strings.SplitN(p, "/", 2)[0], "."):
+			return OriginStdlib, "", p
+		}
+		return OriginDependency, "", p
+	}
+	if _, ok := w.sourceRel(ci, ref.File); ok {
+		return OriginApp, ci.module, ""
+	}
+	if m, rel, ok := moduleFor(w.resolvedModules(ci), ref.File); ok {
+		p := m.Path
+		if d := path.Dir(rel); d != "." {
+			p += "/" + d
+		}
+		if m.Path == fwMod {
+			return OriginFramework, m.Path, p
+		}
+		return OriginDependency, m.Path, p
+	}
+	// Standard library: GOROOT's `.../src/<pkg>/f.go`, or `<pkg>/f.go` under -trimpath
+	// (first element has no dot).
+	dir := path.Dir(ref.File)
+	if i := strings.Index(dir, "/src/"); i >= 0 {
+		return OriginStdlib, "", dir[i+len("/src/"):]
+	}
+	if !strings.HasPrefix(dir, "/") && !strings.Contains(strings.SplitN(dir, "/", 2)[0], ".") {
+		return OriginStdlib, "", dir
+	}
+	return OriginUnknown, "", ""
+}
+
+func inModule(module, p string) bool { return p == module || strings.HasPrefix(p, module+"/") }
+
+// moduleOfFile reads the module and package out of a source path that is not in
+// the app or the framework checkout: `.../pkg/mod/<mod>@<ver>/<dir>/f.go` (module
+// cache), `<mod>@<ver>/<dir>/f.go` (-trimpath), GOROOT's `.../src/<pkg>/f.go` or
+// trimpath's `<pkg>/f.go` (standard library: first element has no dot).
+func moduleOfFile(file string) (module, version, pkg string) {
+	dir := path.Dir(file)
+	rest := dir
+	if i := strings.Index(dir, "/pkg/mod/"); i >= 0 {
+		rest = dir[i+len("/pkg/mod/"):]
+	}
+	if at := strings.Index(rest, "@"); at >= 0 {
+		module = rest[:at]
+		tail := rest[at:]
+		version = tail
+		sub := ""
+		if slash := strings.Index(tail, "/"); slash >= 0 {
+			version, sub = tail[1:slash], tail[slash:]
+		} else {
+			version = tail[1:]
+		}
+		return module, version, module + sub
+	}
+	if i := strings.Index(dir, "/src/"); i >= 0 {
+		return "", "", dir[i+len("/src/"):] // GOROOT, unmodified path
+	}
+	if !strings.HasPrefix(dir, "/") && !strings.Contains(strings.SplitN(dir, "/", 2)[0], ".") {
+		return "", "", dir // -trimpath standard library
+	}
+	return "", "", ""
+}
+
+// symbolPackage is the import path a runtime symbol starts with.
+func symbolPackage(sym string) string {
+	slash := strings.LastIndex(sym, "/")
+	dot := strings.Index(sym[slash+1:], ".")
+	if dot < 0 {
+		return ""
+	}
+	return sym[:slash+1+dot]
+}
+
+func extFuncID(pkg, name string) quad.IRI { return quad.IRI("ext:" + idKey(pkg+"."+name)) }
diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/cmd/spikecalls/main.go fw/cmd/spikecalls/main.go
--- base/cmd/spikecalls/main.go	1970-01-01 02:00:00
+++ fw/cmd/spikecalls/main.go	2026-10-11 10:46:37
@@ -0,0 +1,150 @@
+// spikecalls type-checks a scratch app the way the codegraph calls layer does
+// (go/packages, "./..."), optionally with build tags, and reports time, package
+// counts and the shape of the calls that leave the app module (spike S3).
+package main
+
+import (
+	"flag"
+	"fmt"
+	"go/ast"
+	"go/types"
+	"os"
+	"sort"
+	"strings"
+	"time"
+
+	"golang.org/x/tools/go/packages"
+)
+
+func main() {
+	dir := flag.String("dir", "", "app dir")
+	tags := flag.String("tags", "", "build tags")
+	module := flag.String("module", "example.com/shop", "app module path")
+	fwMod := flag.String("fw", "petars-dev/govibe", "framework module path")
+	detail := flag.Bool("detail", false, "print every external edge")
+	nodeps := flag.Bool("modules", true, "request package module info")
+	flag.Parse()
+
+	mode := packages.NeedName | packages.NeedFiles | packages.NeedCompiledGoFiles | packages.NeedImports |
+		packages.NeedTypes | packages.NeedSyntax | packages.NeedTypesInfo
+	if *nodeps {
+		mode |= packages.NeedModule
+	}
+	cfg := &packages.Config{Dir: *dir, Mode: mode, Tests: false}
+	if *tags != "" {
+		cfg.BuildFlags = []string{"-tags=" + *tags}
+	}
+	t0 := time.Now()
+	pkgs, err := packages.Load(cfg, "./...")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "load:", err)
+		os.Exit(1)
+	}
+	loadDur := time.Since(t0)
+
+	all, typed := 0, 0
+	seen := map[string]bool{}
+	modOf := map[string]*packages.Module{} // every package of the closure, not only the app's direct imports
+	packages.Visit(pkgs, nil, func(p *packages.Package) {
+		modOf[p.PkgPath] = p.Module
+		if !seen[p.PkgPath] {
+			seen[p.PkgPath] = true
+			all++
+			if p.Types != nil && p.Types.Complete() && p.Syntax != nil {
+				typed++
+			}
+		}
+	})
+	appPkgs := 0
+	type edge struct{ from, to, pkg, module, kind string }
+	var edges []edge
+	counts := map[string]int{}
+	for _, p := range pkgs {
+		if !strings.HasPrefix(p.PkgPath, *module) || p.TypesInfo == nil {
+			continue
+		}
+		appPkgs++
+		for _, f := range p.Syntax {
+			for _, d := range f.Decls {
+				fd, ok := d.(*ast.FuncDecl)
+				if !ok || fd.Body == nil {
+					continue
+				}
+				caller := p.PkgPath + "." + fd.Name.Name
+				ast.Inspect(fd.Body, func(n ast.Node) bool {
+					call, ok := n.(*ast.CallExpr)
+					if !ok {
+						return true
+					}
+					var fn *types.Func
+					var sel *types.Selection
+					switch x := ast.Unparen(call.Fun).(type) {
+					case *ast.Ident:
+						fn, _ = p.TypesInfo.Uses[x].(*types.Func)
+					case *ast.SelectorExpr:
+						if s := p.TypesInfo.Selections[x]; s != nil {
+							sel = s
+							fn, _ = s.Obj().(*types.Func)
+						} else {
+							fn, _ = p.TypesInfo.Uses[x.Sel].(*types.Func)
+						}
+					}
+					if fn == nil || fn.Pkg() == nil {
+						return true
+					}
+					fn = fn.Origin()
+					pkgPath := fn.Pkg().Path()
+					class := "stdlib"
+					mod := ""
+					if m := modOf[pkgPath]; m != nil {
+						mod = m.Path + "@" + m.Version
+						if m.Replace != nil {
+							mod += " => " + m.Replace.Path
+						}
+					}
+					switch {
+					case strings.HasPrefix(pkgPath, *module):
+						class = "app"
+					case strings.HasPrefix(pkgPath, *fwMod):
+						class = "framework"
+					case strings.Contains(strings.SplitN(pkgPath, "/", 2)[0], "."):
+						class = "dependency"
+					}
+					kind := "func"
+					if sig, ok := fn.Type().(*types.Signature); ok && sig.Recv() != nil {
+						kind = "method"
+						if types.IsInterface(sig.Recv().Type()) {
+							kind = "interface-method"
+						}
+					}
+					counts[class]++
+					if class != "app" {
+						edges = append(edges, edge{caller, fn.FullName(), pkgPath, mod, class + "/" + kind})
+					}
+					_ = sel
+					return true
+				})
+			}
+		}
+	}
+	fmt.Printf("tags=%q load=%dms roots=%d packages-in-closure=%d with-types-and-syntax=%d app-packages-checked=%d\n",
+		*tags, loadDur.Milliseconds(), len(pkgs), all, typed, appPkgs)
+	fmt.Printf("call sites by target: %v\n", counts)
+	if *detail {
+		sort.Slice(edges, func(i, j int) bool {
+			if edges[i].kind != edges[j].kind {
+				return edges[i].kind < edges[j].kind
+			}
+			return edges[i].to < edges[j].to
+		})
+		last := ""
+		for _, e := range edges {
+			key := e.kind + e.to
+			if key == last {
+				continue
+			}
+			last = key
+			fmt.Printf("  %-26s %-70s pkg=%s module=%s  (from %s)\n", e.kind, e.to, e.pkg, e.module, e.from)
+		}
+	}
+}
