diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/config/layered.go fw/config/layered.go
--- base/config/layered.go	1970-01-01 02:00:00
+++ fw/config/layered.go	2026-10-11 10:28:21
@@ -0,0 +1,84 @@
+package config
+
+import (
+	_ "embed"
+	"fmt"
+	"io/fs"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed defaults.yml
+var defaultsYAML []byte
+
+// Layered is the instance-based configuration of the spike: framework defaults,
+// then the app's env.yml, resolved from the process environment.
+type Layered struct{ raw map[string]any }
+
+// LoadLayered merges defaults.yml (embedded here) with env.yml read from app.
+// app may be nil.
+func LoadLayered(app fs.FS) (*Layered, error) {
+	var base map[string]any
+	if err := yaml.Unmarshal(defaultsYAML, &base); err != nil {
+		return nil, fmt.Errorf("parse defaults.yml: %w", err)
+	}
+	if app != nil {
+		b, err := fs.ReadFile(app, "env.yml")
+		if err != nil {
+			return nil, fmt.Errorf("read app env.yml: %w", err)
+		}
+		var over map[string]any
+		if err := yaml.Unmarshal(b, &over); err != nil {
+			return nil, fmt.Errorf("parse app env.yml: %w", err)
+		}
+		base = merge(base, over)
+	}
+	res, _ := resolveNode(base).(map[string]any)
+	return &Layered{raw: res}, nil
+}
+
+// merge deep-merges over into base: maps merge, everything else is replaced.
+func merge(base, over map[string]any) map[string]any {
+	for k, v := range over {
+		if bm, ok := base[k].(map[string]any); ok {
+			if om, ok := v.(map[string]any); ok {
+				base[k] = merge(bm, om)
+				continue
+			}
+		}
+		base[k] = v
+	}
+	return base
+}
+
+func (c *Layered) Get(path string) (any, bool) {
+	var cur any = c.raw
+	for _, p := range strings.Split(path, ".") {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		if cur, ok = m[p]; !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
+
+func (c *Layered) String(path string) string {
+	v, _ := c.Get(path)
+	if v == nil {
+		return ""
+	}
+	return fmt.Sprint(v)
+}
+
+func (c *Layered) Unmarshal(path string, out any) error {
+	v, ok := c.Get(path)
+	if !ok {
+		return fmt.Errorf("config path not found: %s", path)
+	}
+	b, _ := yaml.Marshal(v)
+	return yaml.Unmarshal(b, out)
+}
