diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/internal/kernel/kernel.go fw/internal/kernel/kernel.go
--- base/internal/kernel/kernel.go	1970-01-01 02:00:00
+++ fw/internal/kernel/kernel.go	2026-10-11 10:46:27
@@ -0,0 +1,127 @@
+// Package kernel is the prototype boot path shared by Main, serve, inspect and tests.
+package kernel
+
+import (
+	"context"
+	"fmt"
+	"io/fs"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/chi/v5/middleware"
+	"github.com/jmoiron/sqlx"
+	"github.com/sirupsen/logrus"
+
+	"petars-dev/govibe/config"
+	"petars-dev/govibe/internal/routeinfo"
+	"petars-dev/govibe/web"
+)
+
+type App struct {
+	Name       string
+	Config     fs.FS
+	Migrations fs.FS
+	Assets     fs.FS
+	Routes     func(rt *Runtime, r chi.Router) error
+	Commands   func(rt *Runtime) []Command
+	Shutdown   func(ctx context.Context) error
+}
+
+type Runtime struct {
+	Config *config.Layered
+	Log    logrus.FieldLogger
+	DB     *sqlx.DB
+}
+
+type RunFunc func(ctx context.Context, rt *Runtime, args []string) error
+
+type Command struct {
+	Use, Short string
+	Run        RunFunc
+}
+
+// BuildOptions say which parts of the boot sequence run.
+type BuildOptions struct {
+	OpenDB   bool // open the database pool when a DSN is set
+	DevMount bool // mount the dev tooling (needs the govibe_dev build tag too)
+	AssetDir string
+}
+
+type Built struct {
+	App      App
+	Rt       *Runtime
+	Router   chi.Router
+	Commands []Command
+	Notes    []string // what the boot did, for the spike's assertions
+	// FrameworkRoutes are "METHOD path" of every route registered before App.Routes ran.
+	FrameworkRoutes map[string]bool
+}
+
+var devMount func(b *Built, r chi.Router) // set by dev_mount.go under the govibe_dev tag
+
+func Build(app App, opt BuildOptions) (*Built, error) {
+	cfg, err := config.LoadLayered(app.Config)
+	if err != nil {
+		return nil, err
+	}
+	rt := &Runtime{Config: cfg, Log: logrus.WithField("app", app.Name)}
+	b := &Built{App: app, Rt: rt}
+	if opt.OpenDB && cfg.String("database.mariadb.dsn") != "" {
+		return nil, fmt.Errorf("spike: database open not implemented")
+	}
+	r := chi.NewRouter()
+	r.Use(middleware.RequestID, middleware.RealIP, middleware.Recoverer, web.RequestTag)
+
+	// Assets: disk when ./assets exists and env is local/dev, else embedded App.Assets.
+	env := cfg.String("env")
+	dir := opt.AssetDir
+	if dir == "" {
+		dir = "assets"
+	}
+	if st, err := os.Stat(dir); (env == "local" || env == "dev") && err == nil && st.IsDir() {
+		b.Notes = append(b.Notes, "assets: disk "+dir)
+		r.Handle("/assets/*", http.StripPrefix("/assets", http.FileServer(http.Dir(dir))))
+	} else if app.Assets != nil {
+		b.Notes = append(b.Notes, "assets: embedded")
+		r.Handle("/assets/*", http.StripPrefix("/assets", http.FileServerFS(app.Assets)))
+	}
+
+	// Framework runtime namespace: one handler of every shape.
+	v := &web.Version{V: "0.0.0-spike"}
+	r.Get("/_govibe/ping", web.Ping)
+	r.Get("/_govibe/health", web.Health("shop"))
+	r.Get("/_govibe/version", v.Handle)
+	r.Handle("/_govibe/static/*", web.Static{Msg: "static"})
+	r.Get("/_govibe/inline", func(w http.ResponseWriter, r *http.Request) { web.JSON(w, 200, "inline") })
+
+	b.FrameworkRoutes = map[string]bool{}
+	for _, fr := range routeinfo.Walk(r) {
+		b.FrameworkRoutes[fr.Method+" "+fr.Path] = true
+	}
+	if app.Routes != nil {
+		if err := app.Routes(rt, r); err != nil {
+			return nil, fmt.Errorf("routes: %w", err)
+		}
+	}
+	for _, p := range reservedClash(r) {
+		return nil, fmt.Errorf("app registered %s under a reserved prefix", p)
+	}
+	b.Router = r
+	if app.Commands != nil {
+		b.Commands = app.Commands(rt)
+	}
+	if opt.DevMount && devMount != nil && !strings.EqualFold(env, "prod") {
+		devMount(b, r)
+		b.Notes = append(b.Notes, "dev: mounted")
+	} else if opt.DevMount {
+		b.Notes = append(b.Notes, "dev: not compiled in")
+	}
+	return b, nil
+}
+
+func reservedClash(r chi.Router) []string { return nil }
+
+// Env is a method on the alias target: a call from the app lands in internal/kernel.
+func (rt *Runtime) Env() string { return rt.Config.String("env") }
diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/internal/migrate/migrate.go fw/internal/migrate/migrate.go
--- base/internal/migrate/migrate.go	1970-01-01 02:00:00
+++ fw/internal/migrate/migrate.go	2026-10-11 10:44:25
@@ -0,0 +1,46 @@
+// Package migrate is the prototype of the goose runner: instance-based (the
+// goose Provider API), dialect always explicit, reads the app's handed-over fs.FS.
+package migrate
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"io/fs"
+
+	"github.com/pressly/goose/v3"
+)
+
+// Dir is the directory the app's embed holds: `//go:embed sql/*.sql`.
+const Dir = "sql"
+
+func provider(db *sql.DB, dialect goose.Dialect, migrations fs.FS) (*goose.Provider, error) {
+	sub, err := fs.Sub(migrations, Dir)
+	if err != nil {
+		return nil, err
+	}
+	return goose.NewProvider(dialect, db, sub)
+}
+
+// Up applies every pending migration.
+func Up(ctx context.Context, db *sql.DB, dialect goose.Dialect, migrations fs.FS) error {
+	p, err := provider(db, dialect, migrations)
+	if err != nil {
+		return fmt.Errorf("migrations: %w", err)
+	}
+	_, err = p.Up(ctx)
+	return err
+}
+
+// List names the migrations the handed-over FS holds; it touches no database.
+func List(db *sql.DB, dialect goose.Dialect, migrations fs.FS) ([]string, error) {
+	p, err := provider(db, dialect, migrations)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, s := range p.ListSources() {
+		out = append(out, fmt.Sprintf("%d:%s", s.Version, s.Path))
+	}
+	return out, nil
+}
diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/internal/migrate/migrate_test.go fw/internal/migrate/migrate_test.go
--- base/internal/migrate/migrate_test.go	1970-01-01 02:00:00
+++ fw/internal/migrate/migrate_test.go	2026-10-11 10:44:25
@@ -0,0 +1,58 @@
+package migrate
+
+import (
+	"database/sql"
+	"testing"
+	"testing/fstest"
+
+	_ "github.com/go-sql-driver/mysql"
+	"github.com/pressly/goose/v3"
+)
+
+// What an app's `//go:embed sql/*.sql` embed.FS looks like from the outside.
+var appFS = fstest.MapFS{
+	"sql/0001_init.sql": {Data: []byte("-- +goose Up\nCREATE TABLE t (id INT);\n-- +goose Down\nDROP TABLE t;\n")},
+	"sql/0002_more.sql": {Data: []byte("-- +goose Up\nALTER TABLE t ADD c INT;\n-- +goose Down\nALTER TABLE t DROP c;\n")},
+}
+
+// sql.Open does not dial: the provider only needs the handle to exist.
+func unopened(t *testing.T) *sql.DB {
+	db, err := sql.Open("mysql", "nobody:nothing@tcp(127.0.0.1:1)/none")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return db
+}
+
+func TestListFromHandedOverFS(t *testing.T) {
+	got, err := List(unopened(t), goose.DialectMySQL, appFS)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0] != "1:0001_init.sql" {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestDialectCannotBeOmitted(t *testing.T) {
+	if _, err := List(unopened(t), "", appFS); err == nil {
+		t.Fatal("an empty dialect must be an error (the global goose API silently picks postgres)")
+	}
+}
+
+func TestMissingSqlDirIsAnError(t *testing.T) {
+	if got, err := List(unopened(t), goose.DialectMySQL, fstest.MapFS{"other/x.sql": {}}); err == nil {
+		t.Fatalf("want an error for an FS without sql/, got %v", got)
+	}
+}
+
+// The global API the repo uses today, for comparison: process-wide state.
+func TestGlobalAPIStillCollects(t *testing.T) {
+	goose.SetBaseFS(appFS)
+	t.Cleanup(func() { goose.SetBaseFS(nil) })
+	ms, err := goose.CollectMigrations("sql", 0, goose.MaxVersion)
+	if err != nil || len(ms) != 2 {
+		t.Fatalf("%v %v", ms, err)
+	}
+}
diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/internal/routeinfo/routeinfo.go fw/internal/routeinfo/routeinfo.go
--- base/internal/routeinfo/routeinfo.go	1970-01-01 02:00:00
+++ fw/internal/routeinfo/routeinfo.go	2026-10-11 10:32:41
@@ -0,0 +1,126 @@
+// Package routeinfo reads a live chi router into plain data: method, path and
+// the runtime's description of each handler and middleware. It depends on chi,
+// reflect and runtime only, so the app binary can use it (inspect --json) while
+// the heavy graph code stays out of a default build.
+package routeinfo
+
+import (
+	"net/http"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"sort"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// AnyMethod is the method token of a route registered for every method.
+const AnyMethod = "ANY"
+
+// Route is one route as the running router reports it.
+type Route struct {
+	Method  string // upper-case HTTP method, or AnyMethod
+	Path    string
+	Handler Ref
+	MW      []Ref // middleware, outermost first
+	// Mounted says who registered the route: "framework" (before App.Routes ran),
+	// "app", or "" when unknown. The handler's own origin can differ (an app
+	// mounting web.Ping, the framework mounting http.FileServer).
+	Mounted string
+}
+
+// Ref is a function as the Go runtime describes it.
+type Ref struct {
+	Symbol string
+	File   string
+	Line   int
+}
+
+type middlewareFunc = func(http.Handler) http.Handler
+
+func Sort(rs []Route) []Route {
+	sort.SliceStable(rs, func(i, j int) bool {
+		if rs[i].Path != rs[j].Path {
+			return rs[i].Path < rs[j].Path
+		}
+		return rs[i].Method < rs[j].Method
+	})
+	return rs
+}
+
+// Walk walks a chi router (sub-routers, groups, per-level middleware).
+func Walk(r chi.Routes) []Route {
+	var out []Route
+	walk(r, "", nil, &out)
+	return Sort(out)
+}
+
+func walk(r chi.Routes, parent string, parentMW []middlewareFunc, out *[]Route) {
+	for _, route := range r.Routes() {
+		mws := append(append([]middlewareFunc(nil), parentMW...), r.Middlewares()...)
+		if route.SubRoutes != nil {
+			walk(route.SubRoutes, parent+route.Pattern, mws, out)
+			continue
+		}
+		path := strings.ReplaceAll(parent+route.Pattern, "/*/", "/")
+		emit := func(method string, h http.Handler) {
+			chain := mws
+			if ch, ok := h.(*chi.ChainHandler); ok {
+				chain = append(append([]middlewareFunc(nil), mws...), ch.Middlewares...)
+				h = ch.Endpoint
+			}
+			rr := Route{Method: method, Path: path, Handler: HandlerRef(h)}
+			for _, m := range chain {
+				rr.MW = append(rr.MW, FuncRef(reflect.ValueOf(m)))
+			}
+			*out = append(*out, rr)
+		}
+		if all, ok := route.Handlers["*"]; ok {
+			emit(AnyMethod, all)
+			for m, h := range route.Handlers {
+				if m != "*" && HandlerRef(unwrap(h)) != HandlerRef(unwrap(all)) {
+					emit(m, h)
+				}
+			}
+			continue
+		}
+		for m, h := range route.Handlers {
+			emit(m, h)
+		}
+	}
+}
+
+func unwrap(h http.Handler) http.Handler {
+	if ch, ok := h.(*chi.ChainHandler); ok {
+		return ch.Endpoint
+	}
+	return h
+}
+
+// HandlerRef identifies the function that serves h.
+func HandlerRef(h http.Handler) Ref {
+	v := reflect.ValueOf(h)
+	if !v.IsValid() {
+		return Ref{}
+	}
+	if v.Kind() == reflect.Func {
+		return FuncRef(v)
+	}
+	if m, ok := v.Type().MethodByName("ServeHTTP"); ok {
+		return FuncRef(m.Func)
+	}
+	return Ref{}
+}
+
+func FuncRef(v reflect.Value) Ref {
+	if !v.IsValid() || v.Kind() != reflect.Func || v.IsNil() {
+		return Ref{}
+	}
+	fn := runtime.FuncForPC(v.Pointer())
+	if fn == nil {
+		return Ref{}
+	}
+	file, line := fn.FileLine(fn.Entry())
+	return Ref{Symbol: fn.Name(), File: filepath.ToSlash(file), Line: line}
+}
