+// Package govibetest boots an App in a test.
+package govibetest
+
+import (
+	"net/http"
+	"testing"
+
+	"petars-dev/govibe/internal/kernel"
+)
+
+// Boot builds the app's handler with the given environment (t.Setenv per entry).
+func Boot(t testing.TB, app kernel.App, env map[string]string) (http.Handler, *kernel.Built) {
+	t.Helper()
+	for k, v := range env {
+		t.Setenv(k, v)
+	}
+	b, err := kernel.Build(app, kernel.BuildOptions{})
+	if err != nil {
+		t.Fatalf("boot: %v", err)
+	}
+	return b.Router, b
+}
