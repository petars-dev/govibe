diff -ruN -x *.bolt -x cmd_generate.go -x root.go base/web/web.go fw/web/web.go
--- base/web/web.go	1970-01-01 02:00:00
+++ fw/web/web.go	2026-10-11 10:42:52
@@ -0,0 +1,46 @@
+// Package web is the prototype of the framework's public web helpers.
+package web
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+func JSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+// Ping is a plain named framework handler.
+func Ping(w http.ResponseWriter, r *http.Request) {
+	JSON(w, 200, map[string]string{"pong": "framework"})
+}
+
+// Health returns a closure: a framework handler built by a factory.
+func Health(name string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) { JSON(w, 200, map[string]string{"ok": name}) }
+}
+
+// Version is a framework type whose method value is mounted.
+type Version struct{ V string }
+
+func (v *Version) Handle(w http.ResponseWriter, r *http.Request) {
+	JSON(w, 200, map[string]string{"version": v.V})
+}
+
+// Static is a framework http.Handler type (ServeHTTP).
+type Static struct{ Msg string }
+
+func (s Static) ServeHTTP(w http.ResponseWriter, r *http.Request) { _, _ = w.Write([]byte(s.Msg)) }
+
+// RequestTag is framework middleware.
+func RequestTag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Govibe", "1")
+		next.ServeHTTP(w, r)
+	})
+}
+
+// IfDev-style helper stand-in used by the app's view code.
+func IsDev(r *http.Request) bool { return false }
