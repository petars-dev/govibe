--- base/govibe.go	1970-01-01 02:00:00
+++ fw/govibe.go	2026-10-11 10:42:52
@@ -0,0 +1,237 @@
+// Package govibe is the prototype of the framework's public entry point.
+package govibe
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"reflect"
+	"runtime"
+	"runtime/debug"
+	"strings"
+	"syscall"
+	"time"
+
+	"petars-dev/govibe/config"
+	"petars-dev/govibe/internal/kernel"
+	"petars-dev/govibe/internal/routeinfo"
+)
+
+type (
+	App     = kernel.App
+	Runtime = kernel.Runtime
+	Command = kernel.Command
+	RunFunc = kernel.RunFunc
+)
+
+func Main(app App) {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	if err := Run(ctx, app, os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+}
+
+func Run(ctx context.Context, app App, args []string, out, errOut io.Writer) error {
+	name := "serve"
+	if len(args) > 0 {
+		name, args = args[0], args[1:]
+	}
+	switch name {
+	case "serve":
+		b, err := kernel.Build(app, kernel.BuildOptions{OpenDB: true, DevMount: true})
+		if err != nil {
+			return err
+		}
+		return serve(ctx, b, out)
+	case "routes":
+		b, err := kernel.Build(app, kernel.BuildOptions{})
+		if err != nil {
+			return err
+		}
+		for _, r := range routeinfo.Walk(b.Router) {
+			fmt.Fprintf(out, "%-4s %-28s %s\n", r.Method, r.Path, r.Handler.Symbol)
+		}
+		return nil
+	case "inspect":
+		fs := flag.NewFlagSet("inspect", flag.ContinueOnError)
+		asJSON := fs.Bool("json", false, "print the inspect document")
+		if err := fs.Parse(args); err != nil {
+			return err
+		}
+		if !*asJSON {
+			return fmt.Errorf("inspect: only --json is supported")
+		}
+		b, err := kernel.Build(app, kernel.BuildOptions{}) // no DB, no dev mount, no scheduler
+		if err != nil {
+			return err
+		}
+		enc := json.NewEncoder(out)
+		enc.SetIndent("", "  ")
+		return enc.Encode(Inspect(b))
+	}
+	b, err := kernel.Build(app, kernel.BuildOptions{OpenDB: true})
+	if err != nil {
+		return err
+	}
+	for _, c := range b.Commands {
+		if c.Use == name {
+			return c.Run(ctx, b.Rt, args)
+		}
+	}
+	return fmt.Errorf("unknown command %q", name)
+}
+
+func serve(ctx context.Context, b *kernel.Built, out io.Writer) error {
+	port := b.Rt.Config.String("server.port")
+	srv := &http.Server{Addr: ":" + port, Handler: b.Router, ReadTimeout: 10 * time.Second}
+	for _, n := range b.Notes {
+		fmt.Fprintln(out, "boot:", n)
+	}
+	fmt.Fprintf(out, "listening on http://localhost:%s\n", port)
+	go func() { <-ctx.Done(); _ = srv.Shutdown(context.Background()) }()
+	if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+		return err
+	}
+	if b.App.Shutdown != nil {
+		return b.App.Shutdown(context.Background())
+	}
+	return nil
+}
+
+// ---- inspect ----------------------------------------------------------------
+
+const InspectSchema = "govibe.inspect/1"
+
+type InspectDoc struct {
+	Schema    string         `json:"schema"`
+	App       InspectApp     `json:"app"`
+	Framework InspectModule  `json:"framework"`
+	Go        string         `json:"go"`
+	Build     InspectBuild   `json:"build"`
+	Routes    []InspectRoute `json:"routes"`
+	Commands  []InspectCmd   `json:"commands"`
+}
+type InspectApp struct {
+	Name   string `json:"name"`
+	Module string `json:"module"`
+	// RootHint is where the app's routes function was compiled: with its import
+	// path it recovers the compile-time root of the module (see S2).
+	RootHint InspectRef `json:"root_hint"`
+}
+type InspectModule struct {
+	Module  string `json:"module"`
+	Version string `json:"version"`
+}
+type InspectBuild struct {
+	Trimpath bool   `json:"trimpath"`
+	Tags     string `json:"tags,omitempty"`
+	// Modules is the build's dependency table (debug.ReadBuildInfo): with it a
+	// source path maps to a module exactly, whatever GOMODCACHE, -trimpath or
+	// `replace` made of it.
+	Modules []BuildModule `json:"modules"`
+}
+
+// BuildModule is one dependency of the app binary.
+type BuildModule struct {
+	Path       string `json:"path"`
+	Version    string `json:"version"`
+	ReplaceDir string `json:"replace_dir,omitempty"` // the directory a local `replace` points at, as compiled
+}
+type InspectRef struct {
+	Symbol string `json:"symbol"`
+	File   string `json:"file"`
+	Line   int    `json:"line"`
+}
+type InspectRoute struct {
+	Method     string       `json:"method"`
+	Path       string       `json:"path"`
+	Handler    InspectRef   `json:"handler"`
+	MountedBy  string       `json:"mounted_by"` // framework | app: who registered the route
+	Middleware []InspectRef `json:"middleware,omitempty"`
+}
+type InspectCmd struct {
+	Name    string     `json:"name"`
+	Short   string     `json:"short"`
+	Handler InspectRef `json:"handler"`
+}
+
+// frameworkModule is derived, not hard-coded: the module that holds this package.
+func frameworkModule() string {
+	return strings.TrimSuffix(reflect.TypeOf(config.Layered{}).PkgPath(), "/config")
+}
+
+func Inspect(b *kernel.Built) InspectDoc {
+	bi, _ := debug.ReadBuildInfo()
+	doc := InspectDoc{Schema: InspectSchema, Go: runtime.Version()}
+	doc.App.Name = b.App.Name
+	if bi != nil {
+		doc.App.Module = bi.Main.Path
+		doc.Build.Modules = []BuildModule{}
+		for _, d := range bi.Deps {
+			m := BuildModule{Path: d.Path, Version: d.Version}
+			// A local replace is recorded as `=> ../fw (devel)`: its Version is
+			// "(devel)", not empty, and its path is as written in go.mod.
+			if d.Replace != nil && (strings.HasPrefix(d.Replace.Path, ".") || strings.HasPrefix(d.Replace.Path, "/")) {
+				m.ReplaceDir = d.Replace.Path
+			}
+			doc.Build.Modules = append(doc.Build.Modules, m)
+		}
+		for _, s := range bi.Settings {
+			switch s.Key {
+			case "-trimpath":
+				doc.Build.Trimpath = s.Value == "true"
+			case "-tags":
+				doc.Build.Tags = s.Value
+			}
+		}
+	}
+	doc.Framework.Module = frameworkModule()
+	doc.Framework.Version = "(devel)"
+	if bi != nil {
+		for _, d := range bi.Deps {
+			if d.Path == doc.Framework.Module {
+				doc.Framework.Version = d.Version
+			}
+		}
+	}
+	if b.App.Routes != nil {
+		doc.App.RootHint = refOf(routeinfo.FuncRef(reflect.ValueOf(b.App.Routes)))
+	}
+	for _, r := range routeinfo.Walk(b.Router) {
+		ir := InspectRoute{Method: r.Method, Path: r.Path, Handler: refOf(r.Handler), MountedBy: "app"}
+		if b.FrameworkRoutes[r.Method+" "+r.Path] {
+			ir.MountedBy = "framework"
+		}
+		for _, m := range r.MW {
+			ir.Middleware = append(ir.Middleware, refOf(m))
+		}
+		doc.Routes = append(doc.Routes, ir)
+	}
+	doc.Commands = []InspectCmd{}
+	for _, c := range b.Commands {
+		doc.Commands = append(doc.Commands, InspectCmd{Name: c.Use, Short: c.Short,
+			Handler: refOf(routeinfo.FuncRef(reflect.ValueOf(c.Run)))})
+	}
+	return doc
+}
+
+func refOf(r routeinfo.Ref) InspectRef {
+	return InspectRef{Symbol: r.Symbol, File: r.File, Line: r.Line}
+}
+
+// pkgOf returns the import path of the package of a runtime symbol.
+func pkgOf(sym string) string {
+	slash := strings.LastIndex(sym, "/")
+	dot := strings.Index(sym[slash+1:], ".")
+	if dot < 0 {
+		return ""
+	}
+	return sym[:slash+1+dot]
+}
