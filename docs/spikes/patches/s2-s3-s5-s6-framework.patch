+// spikeindex runs the indexer offline over a scratch app, with its routes read
+// from the app's `inspect --json` document (spikes S2 and S6).
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path"
+	"sort"
+	"strings"
+
+	"github.com/sirupsen/logrus"
+
+	"petars-dev/govibe/business/services/codegraph"
+	"petars-dev/govibe/internal/routeinfo"
+	"petars-dev/govibe/storage/graphdb"
+)
+
+type doc struct {
+	Framework struct {
+		Module string `json:"module"`
+	} `json:"framework"`
+	Build struct {
+		Modules []struct {
+			Path       string `json:"path"`
+			Version    string `json:"version"`
+			ReplaceDir string `json:"replace_dir"`
+		} `json:"modules"`
+	} `json:"build"`
+	App struct {
+		Module   string `json:"module"`
+		RootHint struct {
+			Symbol string `json:"symbol"`
+			File   string `json:"file"`
+		} `json:"root_hint"`
+	} `json:"app"`
+	Routes []struct {
+		Method    string `json:"method"`
+		Path      string `json:"path"`
+		MountedBy string `json:"mounted_by"`
+		Handler   struct {
+			Symbol string `json:"symbol"`
+			File   string `json:"file"`
+			Line   int    `json:"line"`
+		} `json:"handler"`
+		Middleware []struct {
+			Symbol string `json:"symbol"`
+			File   string `json:"file"`
+			Line   int    `json:"line"`
+		} `json:"middleware"`
+	} `json:"routes"`
+}
+
+func main() {
+	root := flag.String("root", "", "app root")
+	in := flag.String("inspect", "", "inspect --json file")
+	store := flag.String("store", "", "scratch graph dir")
+	noHint := flag.Bool("no-build-root", false, "do not pass the build root (what the old code does)")
+	layers := flag.String("layers", "code,routes,docs,findings", "layers to run")
+	flag.Parse()
+	logrus.SetLevel(logrus.WarnLevel)
+
+	raw, err := os.ReadFile(*in)
+	must(err)
+	var d doc
+	must(json.Unmarshal(raw, &d))
+
+	// Build root from the hint: the routes function's file minus its package dir.
+	buildRoot := ""
+	if !*noHint {
+		pkgPath := d.App.RootHint.Symbol[:strings.Index(d.App.RootHint.Symbol[strings.LastIndex(d.App.RootHint.Symbol, "/")+1:], ".")+strings.LastIndex(d.App.RootHint.Symbol, "/")+1]
+		rel := strings.TrimPrefix(pkgPath, d.App.Module)
+		rel = strings.TrimPrefix(rel, "/")
+		dir := path.Dir(d.App.RootHint.File)
+		buildRoot, _ = strings.CutSuffix(dir, rel)
+		if rel == "" || pkgPath == "main" {
+			buildRoot = dir + "/"
+		}
+		if !strings.HasSuffix(buildRoot, "/") {
+			buildRoot += "/"
+		}
+	}
+	src := func() ([]routeinfo.Route, error) {
+		var out []routeinfo.Route
+		for _, r := range d.Routes {
+			rr := routeinfo.Route{Mounted: r.MountedBy, Method: r.Method, Path: r.Path, Handler: routeinfo.Ref{Symbol: r.Handler.Symbol, File: r.Handler.File, Line: r.Handler.Line}}
+			for _, m := range r.Middleware {
+				rr.MW = append(rr.MW, routeinfo.Ref{Symbol: m.Symbol, File: m.File, Line: m.Line})
+			}
+			out = append(out, rr)
+		}
+		return out, nil
+	}
+
+	h, err := graphdb.Open(*store)
+	must(err)
+	defer h.Close()
+	var mods []codegraph.BuildModule
+	for _, m := range d.Build.Modules {
+		mods = append(mods, codegraph.BuildModule{Path: m.Path, Version: m.Version, ReplaceDir: m.ReplaceDir})
+	}
+	ix := codegraph.New(h.QuadStore, codegraph.Options{Root: *root, RouteSource: src, BuildRoot: buildRoot, Modules: mods, FrameworkModule: d.Framework.Module})
+	rep, err := ix.RunLayers(context.Background(), strings.Split(*layers, ","))
+	must(err)
+	fmt.Println("buildRoot:", buildRoot)
+	for _, l := range rep.Layers {
+		if l.Ran || l.Status != "ok" {
+			fmt.Printf("layer %-9s %-8s quads=%d %v\n", l.Name, l.Status, l.Quads, l.Warnings)
+		}
+	}
+	m, err := ix.Model(context.Background())
+	must(err)
+	var lines []string
+	for _, n := range m.Kind("route") {
+		str := func(p string) string {
+			if v := n.Attrs[p]; len(v) > 0 {
+				return fmt.Sprint(v[0])
+			}
+			return ""
+		}
+		to := ""
+		for _, id := range n.Out["handled_by"] {
+			t := m.Node(id)
+			to += id
+			if t != nil {
+				if o := t.Attrs["origin"]; len(o) > 0 {
+					to += " (origin " + fmt.Sprint(o[0]) + ")"
+				}
+			}
+		}
+		lines = append(lines, fmt.Sprintf("%-22s route=%-9s handler=%-10s -> %s | attr=%s", str("name"), str("origin"), orDash(str("handler_origin")), orDash(to), orDash(str("handler"))))
+	}
+	sort.Strings(lines)
+	for _, l := range lines {
+		fmt.Println(l)
+	}
+	fmt.Println("-- findings")
+	for _, f := range m.AllFindings() {
+		fmt.Printf("%s %s: %s\n", f.Severity, f.Rule, f.Message)
+	}
+}
+
+func orDash(s string) string {
+	if s == "" {
+		return "-"
+	}
+	return s
+}
+
+func must(err error) {
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+}
