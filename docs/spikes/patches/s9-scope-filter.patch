@@ -0,0 +1,90 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"time"
+
+	"petars-dev/govibe/business/services/codegraph"
+	"petars-dev/govibe/storage/graphdb"
+)
+
+func main() {
+	h, err := graphdb.Open("docs/graph")
+	if err != nil {
+		panic(err)
+	}
+	defer h.Close()
+	ctx := context.Background()
+	kinds := []string{"package", "file", "func", "type", "route", "middleware", "template", "mcp_tool", "config_key", "env_var", "doc", "spec", "spec_item", "table", "column", "index", "migration", "annotation", "finding", "rule", "layer", "build", ""}
+	scopes := []codegraph.Scope{codegraph.ScopeAll, codegraph.ScopeApp, codegraph.ScopeFramework}
+	models := map[codegraph.Scope]*codegraph.Model{}
+	for _, s := range scopes {
+		m, err := codegraph.LoadScoped(ctx, h.QuadStore, s)
+		if err != nil {
+			panic(err)
+		}
+		models[s] = m
+	}
+	fmt.Printf("%-12s %6s %6s %6s %8s\n", "kind", "all", "app", "fw", "app+fw")
+	for _, k := range kinds {
+		a, p, f := models[codegraph.ScopeAll].KindCounts()[k], models[codegraph.ScopeApp].KindCounts()[k], models[codegraph.ScopeFramework].KindCounts()[k]
+		name := k
+		if name == "" {
+			name = "(untyped)"
+		}
+		fmt.Printf("%-12s %6d %6d %6d %8d\n", name, a, p, f, p+f)
+	}
+	for _, s := range scopes {
+		m := models[s]
+		fmt.Printf("scope=%-9s quads=%d edges=%d hidden=", s, m.Quads(), m.EdgeCount())
+		b, _ := json.Marshal(m.Hidden())
+		fmt.Println(string(b))
+	}
+	for _, s := range scopes {
+		m := models[s]
+		d, o := m.CheckClosed()
+		start := time.Now()
+		const reps = 20
+		for i := 0; i < reps; i++ {
+			if _, err := codegraph.LoadScoped(ctx, h.QuadStore, s); err != nil {
+				panic(err)
+			}
+		}
+		fmt.Printf("scope=%-9s dangling_edges=%d findings_without_about=%d load_ms=%.1f\n", s, d, o, float64(time.Since(start).Microseconds())/1000/reps)
+	}
+	if len(os.Args) > 1 && os.Args[1] == "origins" {
+		m := models[codegraph.ScopeAll]
+		// origin of each kind sample
+		per := map[string]map[string]int{}
+		for _, k := range kinds {
+			for _, n := range m.Kind(k) {
+				if per[k] == nil {
+					per[k] = map[string]int{}
+				}
+				per[k][m.OriginOf(n.ID)]++
+			}
+		}
+		for _, k := range kinds {
+			fmt.Printf("origin[%s]=%v\n", k, per[k])
+		}
+		for _, k := range []string{"package", "route", "finding", "spec", "doc", "template", "middleware"} {
+			for _, n := range m.Kind(k) {
+				fmt.Printf("  %-10s %-70s %s\n", k, trim(n.ID, 70), m.OriginOf(n.ID))
+			}
+		}
+	}
+	_ = sort.Strings
+	_ = strings.Join
+}
+
+func trim(s string, n int) string {
+	if len(s) > n {
+		return s[:n-1] + "…"
+	}
+	return s
+}
diff -ruN -x *.bolt base/cmd/s9probe/main.go s9/cmd/s9probe/main.go
--- base/cmd/s9probe/main.go	1970-01-01 02:00:00
+++ s9/cmd/s9probe/main.go	2026-10-11 10:31:02
@@ -0,0 +1,43 @@
+// Command s9probe calls one graph tool on the scratch server and prints the text result.
+// usage: s9probe <tool> '<json args>'
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func main() {
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	c := mcp.NewClient(&mcp.Implementation{Name: "s9probe", Version: "0"}, nil)
+	sess, err := c.Connect(ctx, &mcp.StreamableClientTransport{Endpoint: "http://localhost:18094/dev/mcp", DisableStandaloneSSE: true}, nil)
+	if err != nil {
+		panic(err)
+	}
+	defer sess.Close()
+	var args map[string]any
+	if len(os.Args) > 2 {
+		if err := json.Unmarshal([]byte(os.Args[2]), &args); err != nil {
+			panic(err)
+		}
+	}
+	res, err := sess.CallTool(ctx, &mcp.CallToolParams{Name: os.Args[1], Arguments: args})
+	if err != nil {
+		fmt.Println("ERROR:", err)
+		return
+	}
+	for _, ct := range res.Content {
+		if t, ok := ct.(*mcp.TextContent); ok {
+			fmt.Println(t.Text)
+		}
+	}
+	if res.IsError {
+		fmt.Println("(isError)")
+	}
+}
