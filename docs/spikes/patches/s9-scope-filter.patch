diff -ruN -x *.bolt base/business/services/codegraph/origin.go s9/business/services/codegraph/origin.go
--- base/business/services/codegraph/origin.go	1970-01-01 02:00:00
+++ s9/business/services/codegraph/origin.go	2026-10-11 10:39:22
@@ -0,0 +1,294 @@
+package codegraph
+
+// S9 SPIKE: origin classification and scope filter applied once, in the Model.
+// Prototype only: the classification is a stand-in rule table for this repo's own
+// graph (framework and the Hello demo live side by side here), not the design.
+
+import (
+	"sort"
+	"strings"
+	"sync/atomic"
+)
+
+// Scope is which origin a read shows.
+type Scope string
+
+const (
+	ScopeApp       Scope = "app"
+	ScopeFramework Scope = "framework"
+	ScopeAll       Scope = "all"
+)
+
+const (
+	originApp       = "app"
+	originFramework = "framework"
+	originMeta      = "" // build, layer and rule nodes: bookkeeping, in every scope
+)
+
+// defaultScope is what Load applies. A prototype hack so the live server can be
+// flipped between scopes without restarting; the design passes Scope per call.
+var defaultScope atomic.Value
+
+func init() { defaultScope.Store(ScopeAll) }
+
+// SetDefaultScope sets the scope Load applies.
+func SetDefaultScope(s Scope) { defaultScope.Store(s) }
+
+// DefaultScope is the scope Load applies.
+func DefaultScope() Scope { return defaultScope.Load().(Scope) }
+
+// Hidden says what a scope removed from the model: the banner's "n hidden".
+type Hidden struct {
+	Scope  Scope          `json:"scope"`
+	Nodes  int            `json:"nodes"`
+	Edges  int            `json:"edges"`
+	Quads  int            `json:"quads"`
+	ByKind map[string]int `json:"by_kind"`
+}
+
+// originOfPath is the stand-in rule for a repo-relative file path.
+func originOfPath(p string) string {
+	fw := []string{
+		"controllers/dev", "devmcp/", "business/services/codegraph", "storage/dbexplorer", "storage/graphdb",
+		"storage/mariadb", "storage/migrations/embed", "storage/migrations/migrate", "cmd/", "logger/", "config/", "middleware/",
+		"assets/static/graph", "assets/static/docs", "assets/static/cytoscape", "assets/htmx",
+	}
+	for _, f := range fw {
+		if strings.HasPrefix(p, f) {
+			return originFramework
+		}
+	}
+	switch p {
+	case "docs/public/GRAPH_SCHEMA.md", "docs/public/DEV_DB_EXPLORER.md":
+		return originFramework
+	}
+	if strings.HasPrefix(p, "docs/specs/") && p != "docs/specs/SPEC_SAMPLE.md" {
+		return originFramework
+	}
+	return originApp
+}
+
+// classify sets Node.Origin on every node. Order matters: files first, then what
+// derives from files.
+func (m *Model) classify() {
+	// files, by path
+	for _, f := range m.byKind["file"] {
+		f.Origin = originOfPath(f.Str("path"))
+	}
+	// packages: app when any file in it is app (controllers and routes are mixed here)
+	for _, p := range m.byKind["package"] {
+		p.Origin = originFramework
+		files := p.In[string(PredInPackage)]
+		if len(files) == 0 {
+			p.Origin = originOfPath(strings.TrimPrefix(p.ID, "pkg:") + "/")
+			if p.ID == "pkg:." {
+				p.Origin = originApp
+			}
+		}
+		for _, id := range files {
+			if f := m.nodes[id]; f != nil && f.Origin == originApp {
+				p.Origin = originApp
+			}
+		}
+	}
+	for _, n := range m.nodes {
+		switch n.Kind {
+		case "func", "type":
+			n.Origin = originApp
+			if f := m.nodes[n.first(string(PredDefinedIn))]; f != nil {
+				n.Origin = f.Origin
+			}
+		case "template":
+			n.Origin = originOfPath(strings.TrimPrefix(n.ID, "tmpl:") + "/")
+			if f := m.nodes[n.first(string(PredDefinedIn))]; f != nil {
+				n.Origin = f.Origin
+			}
+		case "middleware", "config_key", "env_var", "mcp_tool":
+			n.Origin = originFramework
+		case "table", "column", "index", "migration":
+			n.Origin = originApp
+		case "doc", "spec":
+			n.Origin = originOfPath(n.Str("path"))
+		}
+	}
+	for _, n := range m.byKind["route"] {
+		p := n.Str("path")
+		switch {
+		case strings.HasPrefix(p, "/dev/") || p == "/dev" || strings.HasPrefix(p, "/_govibe/") || strings.HasPrefix(p, "/assets/"):
+			n.Origin = originFramework
+		default:
+			n.Origin = originApp
+			if h := m.nodes[n.first(string(PredHandledBy))]; h != nil {
+				n.Origin = h.Origin
+			}
+		}
+	}
+	for _, n := range m.byKind["spec_item"] {
+		n.Origin = originFramework
+		for _, id := range n.In[string(PredHasItem)] {
+			if s := m.nodes[id]; s != nil {
+				n.Origin = s.Origin
+			}
+		}
+	}
+	// findings take the origin of what they are about
+	for _, n := range m.byKind["finding"] {
+		n.Origin = originApp
+		if t := m.nodes[n.first(string(PredAbout))]; t != nil {
+			n.Origin = t.Origin
+		}
+	}
+	// annotations: neutral, dropped when either end is gone (handled in applyScope)
+}
+
+// applyScope drops every node whose origin is not in scope and every edge that
+// touches one, then rebuilds the lookup tables. It is the whole filter.
+func (m *Model) applyScope(s Scope) *Hidden {
+	h := &Hidden{Scope: s, ByKind: map[string]int{}}
+	m.scope = s
+	m.classify()
+	if s == ScopeAll || s == "" {
+		return h
+	}
+	want := originApp
+	if s == ScopeFramework {
+		want = originFramework
+	}
+	keep := func(n *Node) bool {
+		if n.Kind == "annotation" {
+			return true // decided below, from its ends
+		}
+		return n.Origin == originMeta && (n.Kind == "build" || n.Kind == "layer" || n.Kind == "rule") || n.Origin == want
+	}
+	dropped := map[string]bool{}
+	for id, n := range m.nodes {
+		if !keep(n) {
+			dropped[id] = true
+		}
+	}
+	// annotations follow their ends
+	for _, a := range m.byKind["annotation"] {
+		for _, pred := range []string{string(PredSubject), string(PredObject)} {
+			for _, t := range a.Out[pred] {
+				if dropped[t] {
+					dropped[a.ID] = true
+				}
+			}
+		}
+	}
+	// findings and annotations whose subject is gone are gone too (already by origin for findings)
+	for id := range dropped {
+		n := m.nodes[id]
+		h.Nodes++
+		h.ByKind[n.Kind]++
+	}
+	for id, n := range m.nodes {
+		if dropped[id] {
+			continue
+		}
+		for _, lists := range []map[string][]string{n.Out, n.In} {
+			for pred, l := range lists {
+				kept := l[:0:0]
+				for _, t := range l {
+					if !dropped[t] {
+						kept = append(kept, t)
+					} else {
+						h.Edges++
+					}
+				}
+				if len(kept) == 0 {
+					delete(lists, pred)
+				} else {
+					lists[pred] = kept
+				}
+			}
+		}
+	}
+	for id := range dropped {
+		delete(m.nodes, id)
+	}
+	// recount quads and rebuild the indexes
+	before := m.quads
+	m.quads = 0
+	for _, n := range m.nodes {
+		if n.Kind != "" {
+			m.quads++
+		}
+		for _, v := range n.Attrs {
+			m.quads += len(v)
+		}
+		for _, v := range n.Out {
+			m.quads += len(v)
+		}
+	}
+	h.Quads = before - m.quads
+	m.byKind = map[string][]*Node{}
+	m.ids = m.ids[:0]
+	for id := range m.nodes {
+		m.ids = append(m.ids, id)
+	}
+	sort.Strings(m.ids)
+	for _, id := range m.ids {
+		n := m.nodes[id]
+		m.byKind[n.Kind] = append(m.byKind[n.Kind], n)
+	}
+	m.hidden = h
+	return h
+}
+
+// Hidden reports what the scope removed (nil for scope all).
+func (m *Model) Hidden() *Hidden { return m.hidden }
+
+// Scope is the scope the model was loaded with.
+func (m *Model) Scope() Scope { return m.scope }
+
+// KindCounts is the number of nodes per kind.
+func (m *Model) KindCounts() map[string]int {
+	out := map[string]int{}
+	for k, ns := range m.byKind {
+		out[k] = len(ns)
+	}
+	return out
+}
+
+// EdgeCount is the number of edges (IRI-object quads, minus type quads).
+func (m *Model) EdgeCount() int {
+	n := 0
+	for _, nd := range m.nodes {
+		for _, l := range nd.Out {
+			n += len(l)
+		}
+	}
+	return n
+}
+
+// OriginOf is the origin a node was classified with.
+func (m *Model) OriginOf(id string) string {
+	if n := m.nodes[id]; n != nil {
+		return n.Origin
+	}
+	return "?"
+}
+
+// CheckClosed reports edges that point at, or come from, a node the model does not
+// hold (dangling after a filter), and findings whose `about` node is gone.
+func (m *Model) CheckClosed() (dangling, orphanFindings int) {
+	for id, n := range m.nodes {
+		for _, lists := range []map[string][]string{n.Out, n.In} {
+			for _, l := range lists {
+				for _, t := range l {
+					if m.nodes[t] == nil {
+						dangling++
+					}
+				}
+			}
+		}
+		if n.Kind == "finding" {
+			if len(n.Out[string(PredAbout)]) == 0 {
+				orphanFindings++
+			}
+		}
+		_ = id
+	}
+	return
+}
